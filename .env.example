# Copia questo file in .env e sostituisci il valore con una chiave casuale.
# Genera una chiave con:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# .env è ignorato da git: non committare mai la chiave reale.
DJANGO_SECRET_KEY=replace-with-a-random-secret

# Destinatario delle email del form contatti (opzionale).
CONTACT_EMAIL=contact@example.com
